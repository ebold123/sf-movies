---
import StarIcon from "./StarIcon.astro";
import { preferredDateTimeFmt } from "../shared/dateFormat";
import type { Event } from "../shared/events/event";

interface Props {
  event: Event;
  hidden?: boolean;
}

const { event, hidden = false } = Astro.props;

const dateTimeFormatter = new Intl.DateTimeFormat("en-US", {
  timeZone: "America/Los_Angeles",
  weekday: "short",
  day: "2-digit",
  month: "short",
  year: "numeric",
  hour: "numeric",
  minute: "2-digit",
});
---

<li
  class="movie-card"
  data-title={event.title.toLowerCase()}
  data-start-time={event.startTime}
  data-theater={event.theater}
  data-source-url={event.sourceUrl}
  hidden={hidden}
>
  <div class="movie-card__header">
    <div class="movie-card__title">
      <a href={event.sourceUrl} target="_blank" rel="noopener">
        {event.title}
      </a>
    </div>
    <button class="star-toggle" type="button" aria-label="Add to wish list" aria-pressed="false">
      <StarIcon />
    </button>
  </div>
  { event.synopsis &&
    <button class="movie-card__synopsis" type="button" aria-expanded="false">
      <svg
        class="movie-card__synopsis-triangle"
        viewBox="0 0 10 12"
        aria-hidden="true"
        focusable="false"
      >
        <polygon points="0,0 10,6 0,12"></polygon>
      </svg>
      <span class="movie-card__synopsis-text">{event.synopsis}</span>
    </button>
  }
  <div class="movie-card__meta">
    <span title={event.attribution}>
      {preferredDateTimeFmt(dateTimeFormatter, new Date(event.startTime))}
    </span>
    <span class="movie-card__theater">{event.theater}</span>
  </div>
</li>

<style>
  .movie-card {
    list-style: none;
    background: white;
    color: var(--surface-text);
    border-radius: 0.35rem;
    padding: 0.6rem 1rem;
    line-height: 1.2rem;
    margin-bottom: 2px;
  }

  .movie-card__title a {
    color: var(--surface-link-color);
  }

  .movie-card__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
    margin-bottom: 0.3rem;
  }

  .movie-card__title {
    font-weight: bold;
  }

  .star-toggle {
    flex-shrink: 0;
    background: none;
    border: none;
    cursor: pointer;
    color: #999;
    /* Padding grows the tap target to ~32px; the equal, opposite margin
       cancels it back out for layout purposes, so the header row's height
       is still driven only by the icon and title text, never by this
       padding. */
    padding: 10px;
    margin: -10px;
  }

  .star-toggle[aria-pressed="true"] {
    color: #e0a800;
  }

  @keyframes wishlist-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .movie-card--revealed {
    animation: wishlist-reveal 0.3s ease-out;
  }

  .movie-card__meta {
    display: flex;
    justify-content: space-between;
    font-size: var(--font-size-sm);
  }

  .movie-card__synopsis {
    display: flex;
    align-items: flex-start;
    gap: 0.35rem;
    width: 100%;
    margin: 0.25rem 0;
    padding: 0;
    border: none;
    background: none;
    font: inherit;
    font-size: var(--font-size-sm);
    text-align: left;
    color: inherit;
    cursor: pointer;
  }

  .movie-card__synopsis-triangle {
    flex-shrink: 0;
    /* Sized to the ink of the ▶ this replaced, so the cards look the same:
       10.2 x 11.8px against the synopsis' 14px text. The box matches the
       viewBox ratio, so the polygon fills it rather than letterboxing. */
    width: 0.7em;
    height: 0.84em;
    /* Centres it on the first line rather than the top of the flex row. */
    margin-top: 0.26em;
    fill: rgb(88, 83, 69);
    transition: transform 150ms ease-out;
  }

  .movie-card__synopsis[aria-expanded="true"] .movie-card__synopsis-triangle {
    transform: rotate(90deg);
  }

  .movie-card__synopsis-text {
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .movie-card__synopsis[aria-expanded="true"] .movie-card__synopsis-text {
    white-space: normal;
    overflow: visible;
  }
</style>
